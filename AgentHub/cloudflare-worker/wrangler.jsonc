{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-hub-journal",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOURNAL",
        "class_name": "JournalStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JournalStore"]
    }
  ],
  "routes": [
    {
      "pattern": "hub.darksanctuary.ru/*",
      "zone_name": "darksanctuary.ru"
    }
  ]
}
