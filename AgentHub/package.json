{
  "name": "agent-hub",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "trace:report": "node src/composition/command-trace-report-cli.mjs",
    "start": "node agent-hub-main.mjs",
    "send": "node send-message.mjs",
    "render-code": "python render-code-images.py",
    "send-images": "node send-images.mjs",
    "tts:smoke": "node tts-smoke.mjs",
    "runtime:deploy": "node runtime-manager.mjs deploy",
    "runtime:activate": "node runtime-manager.mjs activate",
    "runtime:status": "node runtime-manager.mjs status",
    "runtime:rollback": "node runtime-manager.mjs rollback",
    "runtime:request-restart": "node request-safe-restart.mjs",
    "worker:build": "node cloudflare-worker/build-assets.mjs",
    "worker:deploy": "node cloudflare-worker/publish-worker.mjs deploy",
    "worker:verify": "node cloudflare-worker/publish-worker.mjs verify",
    "dashboard-bot:pair": "node shared-dashboard-bot-pair.mjs",
    "dashboard-bot:webhook": "node shared-dashboard-bot-webhook.mjs",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File AndroidApp/build.ps1",
    "gateway:install": "node direct-gateway-cli.mjs install",
    "release:version": "node release-version.mjs",
    "release:policy": "node src/interfaces/cli/release-policy.mjs",
    "publish:all": "node publish-all.mjs",
    "publish:changed": "node publish-changed.mjs",
    "hook:install": "node src/infrastructure/codex/codex-hook-config.mjs install",
    "hook:status": "node src/infrastructure/codex/codex-hook-config.mjs status",
    "hook:uninstall": "node src/infrastructure/codex/codex-hook-config.mjs uninstall",
    "work-log:backfill": "node work-log-backfill.mjs",
    "work-log:account-backfill": "node work-log-account-backfill.mjs",
    "work-log:usage-sync": "node work-log-usage-sync.mjs",
    "work-log:claude-backfill": "node claude-work-log-backfill-cli.mjs",
    "work-log:title-backfill": "node work-log-title-backfill-cli.mjs",
    "workspace:migrate": "node src/interfaces/cli/workspace-layout-migrate.mjs",
    "task:reconcile-operation": "node task-operation-reconcile.mjs",
    "task:await-cutover": "node task-await-cutover.mjs",
    "release:recover-freeze": "node release-freeze-recovery.mjs",
    "contracts:check": "node --no-warnings --experimental-vm-modules syntax-check.mjs --contracts-only",
    "contracts:affected": "node contract-registry-cli.mjs affected",
    "rate-limits:backfill": "node rate-limit-backfill.mjs",
    "check": "node --no-warnings --experimental-vm-modules syntax-check.mjs",
    "pretest": "node test-suite.mjs architecture",
    "test": "node test-suite.mjs unit",
    "test:installer": "python -m unittest install_test.py",
    "test:distribution": "python -m unittest discover -s distribution -p \"*_test.py\" -v && python -m unittest discover -s tools -p source_export_test.py -v",
    "test:e2e": "node test-suite.mjs e2e",
    "test:vscode": "node test-suite.mjs vscode",
    "test:visual": "node test-suite.mjs visual",
    "test:cosmetic": "node test-suite.mjs cosmetic",
    "test:stress": "node test-suite.mjs stress",
    "test:reliability": "node test-suite.mjs reliability",
    "test:release-operation": "node --test --test-concurrency=1 tests/application/hub-mcp-service.test.mjs tests/application/task-await-prerelease-integration.test.mjs tests/application/release-operation-command-service.test.mjs tests/application/release-operation-legacy-import.test.mjs tests/application/release-operation-service.test.mjs tests/application/workspace-release-operation-adapter.test.mjs tests/e2e/test-contour-scenario6.e2e.test.mjs tests/infrastructure/filesystem/release-git-workspace.test.mjs tests/infrastructure/filesystem/release-source-line-endings.test.mjs tests/infrastructure/persistence/release-operation-finalization.test.mjs tests/infrastructure/persistence/release-operation-store.test.mjs tests/infrastructure/process/release-operation-publication.test.mjs tests/interfaces/desktop/desktop-application-router.test.mjs tests/public/release-operation-cli.test.mjs tests/public/release-operation-fault-matrix.test.mjs tests/public/runtime-manager.test.mjs",
    "test:core": "npm run check && npm test && npm run test:installer && npm run test:e2e",
    "test:all": "node test-suite.mjs all",
    "doctor": "node doctor.mjs",
    "open:web": "node open-local-web.mjs",
    "contour:install": "node test-contour.mjs install",
    "contour:start": "node test-contour.mjs start",
    "contour:refresh": "node test-contour.mjs refresh",
    "contour:clone-data": "node test-contour.mjs clone-data",
    "contour:open": "node test-contour.mjs open",
    "contour:status": "node test-contour.mjs status",
    "contour:lock": "node test-contour.mjs lock",
    "contour:lock-status": "node test-contour.mjs lock-status",
    "contour:unlock": "node test-contour.mjs unlock",
    "contour:stop": "node test-contour.mjs stop",
    "contour:verify": "node test-contour.mjs verify"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.115.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "jose": "6.2.12"
  }
}
