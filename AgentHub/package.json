{
  "name": "agent-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node agent-hub-main.mjs",
    "send": "node send-message.mjs",
    "render-code": "python render-code-images.py",
    "send-images": "node send-images.mjs",
    "tts:smoke": "node tts-smoke.mjs",
    "runtime:deploy": "node runtime-manager.mjs deploy",
    "runtime:activate": "node runtime-manager.mjs activate",
    "runtime:status": "node runtime-manager.mjs status",
    "runtime:rollback": "node runtime-manager.mjs rollback",
    "runtime:request-restart": "node request-safe-restart.mjs",
    "worker:build": "node cloudflare-worker/build-assets.mjs",
    "worker:deploy": "npm run worker:build && node cloudflare-worker/deploy-worker.mjs && node cloudflare-worker/verify-deployment.mjs",
    "dashboard-bot:pair": "node shared-dashboard-bot-pair.mjs",
    "dashboard-bot:webhook": "node shared-dashboard-bot-webhook.mjs",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File AndroidApp/build.ps1",
    "gateway:install": "node direct-gateway-cli.mjs install",
    "publish:all": "node publish-all.mjs",
    "publish:changed": "node publish-changed.mjs",
    "hook:install": "node src/infrastructure/codex/codex-hook-config.mjs install",
    "hook:status": "node src/infrastructure/codex/codex-hook-config.mjs status",
    "hook:uninstall": "node src/infrastructure/codex/codex-hook-config.mjs uninstall",
    "work-log:backfill": "node work-log-backfill.mjs",
    "work-log:claude-backfill": "node claude-work-log-backfill-cli.mjs",
    "work-log:title-backfill": "node work-log-title-backfill-cli.mjs",
    "workspace:migrate": "node src/interfaces/cli/workspace-layout-migrate.mjs",
    "rate-limits:backfill": "node rate-limit-backfill.mjs",
    "check": "node --no-warnings --experimental-vm-modules syntax-check.mjs",
    "pretest": "node test-suite.mjs architecture",
    "test": "node test-suite.mjs unit",
    "test:e2e": "node --test --test-concurrency=4 tests/e2e/agent-hub-server.e2e.test.mjs tests/e2e/agent-hub-server.claude.e2e.test.mjs tests/e2e/agent-hub-server.desktop.e2e.test.mjs tests/e2e/agent-hub-server.journal.e2e.test.mjs",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "doctor": "node doctor.mjs",
    "open:web": "node open-local-web.mjs"
  },
  "devDependencies": {
    "wrangler": "4.115.0"
  }
}
