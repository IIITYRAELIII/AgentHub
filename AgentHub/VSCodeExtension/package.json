{
  "name": "agent-hub",
  "displayName": "Agent Hub",
  "description": "Agent Hub: задачи, чаты и автоматически обновляемый журнал работ.",
  "version": "0.4.7",
  "publisher": "agent-hub",
  "icon": "media/agent-hub-work-log.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:agentHub.view",
    "onCommand:agentHub.open",
    "onCommand:agentHub.refresh"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test render.test.js agent-hub-bridge.test.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentHub",
          "title": "Agent Hub",
          "icon": "media/journal.svg"
        }
      ]
    },
    "views": {
      "agentHub": [
        {
          "type": "webview",
          "id": "agentHub.view",
          "name": "Agent Hub"
        }
      ]
    },
    "commands": [
      {
        "command": "agentHub.open",
        "title": "Открыть Agent Hub",
        "category": "Agent Hub",
        "icon": "$(open-preview)"
      },
      {
        "command": "agentHub.refresh",
        "title": "Обновить Agent Hub",
        "category": "Agent Hub",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentHub.open",
          "when": "view == agentHub.view",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.refresh",
          "when": "view == agentHub.view",
          "group": "navigation@2"
        }
      ]
    }
  }
}
